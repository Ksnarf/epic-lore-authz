# Runtime image for the PUBLISHED epic-lore-authz release binaries.
#
# Nothing is compiled here: the demo runs the same bytes the project ships, so
# what you validate is what you would deploy. Both binaries are linux/amd64
# and glibc-linked (built on ubuntu-24.04, glibc 2.39), which is why the base
# is Debian rather than Alpine.
#
# The download is checked against demo/release/SHA256SUMS, which is the
# release's own SHA256SUMS asset committed verbatim. A tampered, truncated or
# mismatched download fails the BUILD -- it never reaches a container.
FROM debian:trixie-slim

# Bumping the release is this one line (in demo/docker-compose.yml, which
# passes it in), plus replacing demo/release/SHA256SUMS with the new
# release's asset.
ARG RELEASE_TAG=v0.2.0
ARG RELEASE_BASE_URL=https://github.com/Ksnarf/epic-lore-authz/releases/download

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY release/SHA256SUMS /tmp/release/SHA256SUMS

RUN set -eu; \
    cd /tmp/release; \
    for artifact in lore-authz-server-linux-amd64 loreserver-linux-amd64; do \
        echo "downloading ${RELEASE_TAG}/${artifact}"; \
        curl -fsSL --retry 3 -o "$artifact" "${RELEASE_BASE_URL}/${RELEASE_TAG}/${artifact}"; \
    done; \
    echo "verifying sha256 against the pinned release checksums"; \
    sha256sum -c SHA256SUMS; \
    install -m 0755 lore-authz-server-linux-amd64 /usr/local/bin/lore-authz-server; \
    install -m 0755 loreserver-linux-amd64 /usr/local/bin/loreserver; \
    rm -rf /tmp/release
