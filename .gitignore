# Rust
/target
**/target
Cargo.lock.bak
*.pdb

# Environment / secrets - never commit a real .env
.env
.env.*
!.env.example

# Phase 0 integration-test scratch: generated signing key, generated
# lore-server config, local store data, minted tokens. Regenerated on every
# run, never committed.
/e2e-run/

# Signing key material - never commit real keys
*.jwk
*.pem
*.key
*.der
!**/testdata/**

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs - internal process logs (operator names, local filesystem paths)
# must never land in this public repo; keep them out entirely.
/logs/
*.log
/log.log

# Local working notes. Never committed - this repository is public.
.local-notes/
